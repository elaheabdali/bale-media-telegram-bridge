# ==========================================
# Bale Messenger Bot Configuration
# ==========================================
# Get your bot token from @BotFather in Bale Messenger
BALE_BOT_TOKEN=123456789:your_bale_bot_token_here

# Comma-separated Bale numeric user IDs allowed to use the bot
ALLOWED_BALE_USER_IDS=111111111,222222222

# ==========================================
# Telegram Personal Account (MTProto / Telethon)
# ==========================================
# Obtain API ID & Hash from https://my.telegram.org
TG_API_ID=1234567
TG_API_HASH=your_telegram_api_hash_here

# Generate once by running: python scripts/generate_session.py
TG_SESSION_STRING=your_generated_string_session_here

# ==========================================
# Split Proxy Routing (Optional)
# ==========================================
# Used ONLY for Telethon and yt-dlp. Bale API always connects directly without a proxy.
# Examples: socks5://127.0.0.1:1080 or http://127.0.0.1:8080
PROXY_URL=

# ==========================================
# FastAPI Direct Download Server
# ==========================================
# Public URL where users can reach this server (e.g. https://dl.yourdomain.com or http://SERVER_IP:8000)
PUBLIC_BASE_URL=http://localhost:8000
WEB_HOST=0.0.0.0
WEB_PORT=8000

# ==========================================
# Storage & Delivery Settings
# ==========================================
DOWNLOAD_DIR=downloads
STORAGE_DB_PATH=downloads/storage.db
MAX_BALE_UPLOAD_MB=45
FILE_RETENTION_HOURS=6
CLEANUP_INTERVAL_MINUTES=30
